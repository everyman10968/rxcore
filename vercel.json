{
  "version": 2,
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/$", "dest": "/api/router.php?__route=index.php" },
    { "src": "^/index\\.php$", "dest": "/api/router.php?__route=index.php" },
    { "src": "^/pages/([^/]+\\.php)$", "dest": "/api/router.php?__route=pages/$1" },
    { "src": "^/api/?$", "dest": "/api/index.php" },
    { "src": "^/api/([^/]+\\.php)$", "dest": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron_daily_summary.php",
      "schedule": "30 10 * * *"
    }
  ]
}
