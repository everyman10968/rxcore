# ==============================================================
# RxCore — Environment Configuration Template
# ==============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกำหนดค่าตามสภาพแวดล้อมจริง

# Application Settings
APP_NAME="RxCore"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost/rxcore"
APP_TIMEZONE="Asia/Bangkok"

# Supabase Cloud Configuration (PostgreSQL Database)
# เตรียมไว้สำหรับ Phase ถัดไป (ห้ามเปิดเผยข้อมูลนี้ในหน้า Frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-keep-private"

# PostgreSQL Direct Connection (Supabase Pooler / Direct)
DB_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER="postgres.your-project-id"
DB_PASSWORD="your-strong-db-password"
DB_SCHEMA="public"

# Mock Mode Configuration
# ใน Phase 1: บังคับให้เป็น true เพื่อแสดงเฉพาะข้อมูลจำลอง
MOCK_MODE=true
